rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // v3.3.0: Google sign-in needs Firebase's public sign-up switched ON, which lets bots create password accounts.
    // This rule is what keeps them out: only accounts with a CONFIRMED email may use the database.
    // Google accounts and accounts created by the OTP Worker are always confirmed; a bot-made account never is.
    // Set requireVerifiedEmail() to false only if you keep Firebase's public sign-up switched OFF (and then Google sign-in cannot create new users).
    function requireVerifiedEmail() { return true; }
    function signedIn() {
      return request.auth != null && (!requireVerifiedEmail() || request.auth.token.email_verified == true);
    }

    function evData(eid) { return get(/databases/$(database)/documents/events/$(eid)).data; }
    function isMember(eid) { return signedIn() && request.auth.uid in evData(eid).memberIds; }
    function role(eid) { return evData(eid).members[request.auth.uid].role; }
    function isStaff(eid) { return isMember(eid) && role(eid) in ['owner','organizer','manager','treasurer']; }
    function formData(fid) { return get(/databases/$(database)/documents/payforms/$(fid)).data; }

    // ------------------------------------------------------------------------------------------------
    // v3.6.1: more roles, and custom roles built by the organizer or a manager by ticking permissions.
    //
    // A role is a list of permission keys. The six classic roles keep their own rules below (unchanged). Five new ready-made roles
    // and every custom role are described by a permission list instead:
    //   tick    tick off tasks assigned to them          write   team member basics (tick, add people, payment links, add attendees)
    //   tasks   task groups and assigning tasks          items   items to buy
    //   people  volunteers and who reports to whom       regs    attendees: add, check in, mark paid, teams
    //   event   edit event details, remove registrations, delete any chat message
    //   pay     payments, payment links, UPI settings, online registration     exp   budget, vendors, bills, sponsors (money document)
    // Changing roles, and defining custom roles, stays with owner and manager only. Deleting the event stays with the owner.
    // The five ready-made roles are listed here AND in www/app2.js (BASE). Keep the two lists identical.
    // A custom role is stored in the event as croles.<id> = { id, n (name), p (permission list), at } and its id looks like c_ followed by 3 to 10 letters or digits.
    // ------------------------------------------------------------------------------------------------
    function customRoles(d) { return d.get('croles', {}); }
    function permsOf(d, r) {
      return r == 'coord' ? ['tick','write','tasks','items','regs','people']
           : r == 'desk'  ? ['tick','write','regs']
           : r == 'logi'  ? ['tick','write','tasks','items']
           : r == 'spons' ? ['tick','write','exp']
           : r == 'vol'   ? ['tick']
           : (r.matches('c_[a-z0-9]{3,10}') && r in customRoles(d)) ? customRoles(d)[r].get('p', [])
           : [];
    }
    function evPerms(eid) { return permsOf(evData(eid), role(eid)); }
    function isWriter(eid) { return isMember(eid) && (role(eid) in ['owner','organizer','manager','treasurer','lead','member'] || 'write' in evPerms(eid)); }
    function canExp(eid) { return isStaff(eid) || (isMember(eid) && 'exp' in evPerms(eid)); }
    function canPay(eid) { return isStaff(eid) || (isMember(eid) && 'pay' in evPerms(eid)); }
    function canChat(eid) { return isWriter(eid) || (isMember(eid) && evPerms(eid).size() > 0); }
    function canMod(eid) { return isMember(eid) && (role(eid) in ['owner','organizer','manager'] || 'event' in evPerms(eid)); }
    function seesForm(fid) { return signedIn() && (formData(fid).by == request.auth.uid || canPay(formData(fid).eid)); }

    // Chat text is either a plain string (max 1000 chars) or deflate-compressed bytes flagged with c == 1.
    function chatTextOk(d) {
      return (d.t is string && d.t.size() > 0 && d.t.size() <= 1000 && !('c' in d))
          || (d.t is bytes && d.t.size() > 0 && d.t.size() <= 4000 && 'c' in d && d.c == 1);
    }

    // v3.1.0: @mentions. Optional list 'm' of member ids (max 20), every id must belong to a member of this event.
    function mentionOk(eid, d) {
      return !('m' in d) || (d.m is list && d.m.size() > 0 && d.m.size() <= 20
        && d.m.toSet().difference(evData(eid).memberIds.toSet()).size() == 0);
    }

    // v3.1.0: a payment link is live only while its event still exists AND the expiry time ('until', ms) has not passed.
    // Links created before 3.1.0 have no 'until'; they stay live until the app stamps one on them (see SETUP.md).
    function liveForm(d) {
      return exists(/databases/$(database)/documents/events/$(d.eid))
        && d.get('until', 99999999999999) > request.time.toMillis();
    }

    // v3.5.0: the public registration page is live while the organizer has it switched on, the event still exists and the closing time has not passed.
    function liveReg(d) {
      return d.open == true
        && d.until > request.time.toMillis()
        && exists(/databases/$(database)/documents/events/$(d.eid));
    }

    // ------------------------------------------------------------------------------------------------
    // v3.5.0: who may change what in the event document.
    //
    // Before 3.5.0 any member could write any field of the event, including their own role and the budget.
    // Now each role has a short list of top-level fields it may change. The money data (budget, vendors, bills,
    // payments, sponsors) is not in this document any more: it lives in events/{id}/fin/data, readable and
    // writable only by owner, manager and treasurer.
    // ------------------------------------------------------------------------------------------------
    // Fields that moved to events/{id}/fin/data. They may only be DELETED from the event document (the one-time clean-up).
    function legacy() { return ['bud','ven','exp','payments','don']; }
    function topChanged() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function evRole() { return resource.data.members[request.auth.uid].role; }
    function myPerms() { return permsOf(resource.data, evRole()); }
    function amMember() { return request.auth.uid in resource.data.memberIds; }

    function fieldsOk() {
      let r = evRole();
      let ch = topChanged();
      return (r in ['owner','organizer'] && ch.hasOnly(['info','team','groups','tasks','teams','pay','regs','forms','itm','ntfy','rc','members','memberIds','croles','bud','ven','exp','payments','don']))
          || (r == 'manager' && ch.hasOnly(['info','team','groups','tasks','teams','pay','regs','forms','itm','rc','members','memberIds','croles','bud','ven','exp','payments','don']))
          || (r == 'treasurer' && ch.hasOnly(['team','tasks','teams','pay','regs','forms','itm']))
          || (r == 'lead' && ch.hasOnly(['team','groups','tasks','teams','regs','forms','itm']))
          || (r == 'member' && ch.hasOnly(['team','tasks','teams','regs','forms','itm']))
          || customFieldsOk();
    }

    // v3.6.1: the five ready-made roles and custom roles. Every changed top-level field needs one of the permissions that opens it.
    function customFieldsOk() {
      let p = myPerms();
      let ch = topChanged();
      return p.size() > 0
        && ch.hasOnly(['team','tasks','teams','groups','forms','itm','regs','info','pay'])
        && (!ch.hasAny(['team'])   || p.hasAny(['write','tasks','items','people']))
        && (!ch.hasAny(['tasks'])  || p.hasAny(['write','tick','tasks']))
        && (!ch.hasAny(['teams'])  || p.hasAny(['write','tasks','regs']))
        && (!ch.hasAny(['groups']) || 'tasks' in p)
        && (!ch.hasAny(['forms'])  || p.hasAny(['write','pay']))
        && (!ch.hasAny(['itm'])    || p.hasAny(['write','items']))
        && (!ch.hasAny(['regs'])   || p.hasAny(['write','regs','event','pay']))
        && (!ch.hasAny(['info'])   || 'event' in p)
        && (!ch.hasAny(['pay'])    || 'pay' in p);
    }

    // Custom roles live in the event document; at most 20 of them (the rules cannot loop over the map to check each entry).
    function croleOk() {
      return !topChanged().hasAny(['croles']) || request.resource.data.get('croles', {}).size() <= 20;
    }

    // Attendees are one map entry each (regs.<id>). Organizer and manager: everything. Treasurer and team lead: add and change
    // (check-in, paid, team), never remove. Member: add only. A document holds 1 MiB; 1500 entries is the safety stop (see README).
    function regsOk() {
      let r = evRole();
      return !topChanged().hasAny(['regs'])
        || (request.resource.data.regs.size() <= 1500
            && (r in ['owner','organizer','manager']
                || (r in ['treasurer','lead'] && request.resource.data.regs.diff(resource.data.regs).removedKeys().size() == 0)
                || (r == 'member'
                    && request.resource.data.regs.diff(resource.data.regs).removedKeys().size() == 0
                    && request.resource.data.regs.diff(resource.data.regs).changedKeys().size() == 0)
                // v3.6.1: ready-made and custom roles. 'event' may also remove; 'regs' or 'pay' may add and change; 'write' may only add.
                || 'event' in myPerms()
                || (myPerms().hasAny(['regs','pay']) && request.resource.data.regs.diff(resource.data.regs).removedKeys().size() == 0)
                || ('write' in myPerms()
                    && request.resource.data.regs.diff(resource.data.regs).removedKeys().size() == 0
                    && request.resource.data.regs.diff(resource.data.regs).changedKeys().size() == 0)));
    }

    function legacyOk() {
      return !topChanged().hasAny(legacy()) || !request.resource.data.keys().hasAny(legacy());
    }

    // Changing someone else's role, or removing them. The app sends a small witness field rc = {u: their id, r: new role or '-', at: time}.
    // The rules cannot loop over the members map, so they require that exactly the member named in rc changed, and that the new role matches rc.
    // Owner: can set manager, treasurer, lead, member, viewer, the five ready-made roles (coord, desk, logi, spons, vol) and any custom role that already exists.
    // Manager: the same except manager, and cannot touch another manager or the owner.
    function peopleOk() {
      let n = request.resource.data;
      let o = resource.data;
      let r = evRole();
      return r in ['owner','organizer','manager']
        && topChanged().hasOnly(['rc','members','memberIds'])
        && n.owner == o.owner
        && n.rc is map && n.rc.u is string && n.rc.r is string && n.rc.at is number
        && n.rc.u != request.auth.uid
        && n.rc.u in o.members
        && !(o.members[n.rc.u].role in ['owner','organizer'])
        && (r != 'manager' || o.members[n.rc.u].role != 'manager')
        && n.members.diff(o.members).affectedKeys() == [n.rc.u].toSet()
        && (n.rc.r == '-'
            ? (!(n.rc.u in n.members) && n.memberIds.toSet() == o.memberIds.toSet().difference([n.rc.u].toSet()))
            : ((n.rc.r in (r == 'manager' ? ['treasurer','lead','coord','desk','logi','spons','vol','member','viewer'] : ['manager','treasurer','lead','coord','desk','logi','spons','vol','member','viewer'])
                || (n.rc.r.matches('c_[a-z0-9]{3,10}') && n.rc.r in customRoles(o)))
               && n.members[n.rc.u].role == n.rc.r
               && n.members[n.rc.u].keys().hasOnly(['name','role'])
               && n.members[n.rc.u].name == o.members[n.rc.u].name
               && n.memberIds.toSet() == o.memberIds.toSet()));
    }

    // Anyone in the event may change THEIR OWN display name, nothing else about themselves.
    function ownNameOk() {
      let n = request.resource.data;
      let o = resource.data;
      let me = request.auth.uid;
      return amMember()
        && topChanged().hasOnly(['members'])
        && n.members.diff(o.members).affectedKeys() == [me].toSet()
        && n.members[me].keys().hasOnly(['name','role'])
        && n.members[me].role == o.members[me].role
        && n.members[me].name is string
        && n.members[me].name.size() >= 2 && n.members[me].name.size() <= 40;
    }

    // Leaving an event: remove only yourself (the owner cannot leave, the owner deletes the event).
    function leaveOk() {
      let n = request.resource.data;
      let o = resource.data;
      let me = request.auth.uid;
      return amMember() && o.owner != me
        && topChanged().hasOnly(['members','memberIds'])
        && !(me in n.members)
        && n.members.diff(o.members).affectedKeys() == [me].toSet()
        && n.memberIds.toSet() == o.memberIds.toSet().difference([me].toSet());
    }

    // A non-member may only add THEMSELVES as a plain 'member'. Nothing else may change.
    function joinOk() {
      let n = request.resource.data;
      let o = resource.data;
      let me = request.auth.uid;
      return n.diff(o).affectedKeys().hasOnly(['members','memberIds'])
        && n.memberIds.toSet().difference(o.memberIds.toSet()) == [me].toSet()
        && o.memberIds.toSet().difference(n.memberIds.toSet()).size() == 0
        && n.members.diff(o.members).affectedKeys() == [me].toSet()
        && n.members[me].keys().hasOnly(['name','role'])
        && n.members[me].role == 'member'
        && n.members[me].name is string;
    }

    match /events/{id} {
      // Private: only organiser and joined members can read an event.
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.memberIds);
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;

      // A new event has exactly one member: its creator, as owner.
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid].role == 'owner';

      allow update: if signedIn() && (
        joinOk()
        || leaveOk()
        || ownNameOk()
        || (amMember() && fieldsOk() && regsOk() && legacyOk() && croleOk() && (!topChanged().hasAny(['members','memberIds','rc']) || peopleOk())));

      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      // Money data (v3.5.0): budget lines (bud), vendors (ven), vendor bills (exp), earlier payments (payments), donations (don)
      // and sponsors (spn), one map per kind with one entry per item. Staff only: owner, manager, treasurer (v3.6.1: and any role with the 'exp' permission).
      match /fin/{doc} {
        allow read: if canExp(id);
        allow create, update: if canExp(id)
          && request.resource.data.keys().hasOnly(['bud','ven','exp','payments','don','spn']);
        allow delete: if canExp(id);
      }

      // Event chat (v2.0.0). Members read everything, including messages sent before they joined.
      match /chat/{mid} {
        allow read: if isMember(id);

        // Only a member who may post (any role except a viewer or a custom role with no permissions) can post, only as themselves, with their own member name.
        // 'at' must be the server's time, so nobody can fake or back-date a message.
        allow create: if canChat(id)
          && request.resource.data.keys().hasOnly(['u','n','t','at','c','m'])
          && request.resource.data.u == request.auth.uid
          && request.resource.data.n == evData(id).members[request.auth.uid].name
          && request.resource.data.at == request.time
          && chatTextOk(request.resource.data)
          && mentionOk(id, request.resource.data);

        // Own messages can be edited for 2 hours after they were sent.
        allow update: if canChat(id)
          && resource.data.u == request.auth.uid
          && request.time < resource.data.at + duration.value(2, 'h')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['t','c','ed','m'])
          && request.resource.data.ed == request.time
          && chatTextOk(request.resource.data)
          && mentionOk(id, request.resource.data);

        // Own messages can be deleted for 2 hours. Organizer and managers can delete any message at any time
        // (moderation, and clearing the chat when the event is deleted).
        allow delete: if isMember(id) && (
          (resource.data.u == request.auth.uid && request.time < resource.data.at + duration.value(2, 'h'))
          || canMod(id));
      }
    }

    // Public payment links: anyone with the link can open the form and submit details, but only while the link is live
    // (its event exists and the expiry time has not passed). Organizers and the link's creator can always read it.
    match /payforms/{fid} {
      allow get: if resource == null
        || liveForm(resource.data)
        || (signedIn() && (resource.data.by == request.auth.uid || canPay(resource.data.eid)));
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.by == request.auth.uid
        && (isWriter(request.resource.data.eid) || canPay(request.resource.data.eid))
        && request.resource.data.until is number;
      allow update: if signedIn()
        && (resource.data.by == request.auth.uid || canPay(resource.data.eid))
        && request.resource.data.eid == resource.data.eid
        && request.resource.data.by == resource.data.by
        && request.resource.data.until is number;
      allow delete: if signedIn()
        && (resource.data.by == request.auth.uid || canPay(resource.data.eid));

      match /subs/{sid} {
        // Payers need no account. The document id is the UTR, so a UTR can be submitted only once. Closed once the link expires or the event is deleted.
        allow create: if request.resource.data.keys().hasOnly(['n','a','utr','s','at'])
          && request.resource.data.n is string
          && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 80
          && request.resource.data.a is number
          && request.resource.data.a > 0 && request.resource.data.a <= 10000000
          && request.resource.data.utr is string
          && request.resource.data.utr.matches('[A-Z0-9]{6,40}')
          && request.resource.data.utr == sid
          && request.resource.data.s == 'pending'
          && request.resource.data.at is number
          && exists(/databases/$(database)/documents/payforms/$(fid))
          && liveForm(formData(fid));
        allow get, list: if seesForm(fid);
        allow update: if seesForm(fid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['s'])
          && request.resource.data.s in ['pending','verified','rejected'];
        allow delete: if seesForm(fid);
      }
    }

    // v3.5.0: public self-registration. One page per event; its document id is the event code.
    // Anyone with the link can read the page (event name, date, seats, form questions) and send an application,
    // but only while the page is live. Only owner, manager and treasurer can read applications and approve them.
    match /regpages/{eid} {
      allow get: if resource == null
        || liveReg(resource.data)
        || (signedIn() && canPay(eid));
      allow list: if false;
      allow create, update: if signedIn() && canPay(eid)
        && request.resource.data.eid == eid
        && request.resource.data.open is bool
        && request.resource.data.until is number;
      allow delete: if signedIn() && canPay(eid);

      match /subs/{sid} {
        // The document id is the normalised College ID, so one College ID can apply only once per event (a second create becomes an
        // update, which the public cannot do). The answers travel as one JSON string 'x' (max 3000 characters) so a spammer cannot send huge documents.
        allow create: if request.resource.data.keys().hasOnly(['n','cid','x','em','ph','s','at','utr','pm','cc','cp'])
          && request.resource.data.n is string
          && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 80
          && request.resource.data.cid is string
          && request.resource.data.cid.matches('[A-Z0-9]{3,24}')
          && request.resource.data.cid == sid
          && request.resource.data.x is string && request.resource.data.x.size() <= 3000
          && (!('em' in request.resource.data) || (request.resource.data.em is string && request.resource.data.em.size() <= 100))
          && (!('ph' in request.resource.data) || (request.resource.data.ph is string && request.resource.data.ph.size() <= 20))
          && (!('utr' in request.resource.data) || (request.resource.data.utr is string && request.resource.data.utr.matches('[A-Z0-9]{6,40}')))
          && request.resource.data.s in ['pending','waitlist']
          && request.resource.data.at is number
          // v3.6.0: how the applicant will pay. pm is 'upi' or 'cash'. For cash, cc must be the id of one of the cash collectors the organizer
          // published on the page (cids) and cp says whether they claim to have paid already. Neither can be sent without pm.
          && (!('pm' in request.resource.data) || request.resource.data.pm in ['upi','cash'])
          && (!('cc' in request.resource.data)
              || (request.resource.data.get('pm', '') == 'cash'
                  && request.resource.data.cc is string
                  && request.resource.data.cc in get(/databases/$(database)/documents/regpages/$(eid)).data.get('cids', [])))
          && (!('cp' in request.resource.data) || (request.resource.data.get('pm', '') == 'cash' && request.resource.data.cp is bool))
          && exists(/databases/$(database)/documents/regpages/$(eid))
          && liveReg(get(/databases/$(database)/documents/regpages/$(eid)).data);
        allow get, list: if signedIn() && canPay(eid);
        allow update: if signedIn() && canPay(eid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['s','ri'])
          && request.resource.data.s in ['pending','waitlist','approved','rejected'];
        allow delete: if signedIn() && canPay(eid);
      }
    }

    // v3.6.0: custom registration link names. regslugs/{name} -> { eid, by, at }. Anyone can read one name (that is how register.html finds the event),
    // nobody can list them. A name can be created only by a staff member of the event it points to; a name that exists can only be kept or deleted by staff
    // of the event it points to, so another event cannot take it over.
    match /regslugs/{slug} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && slug.matches('[a-z0-9][a-z0-9-]{1,38}[a-z0-9]')
        && request.resource.data.keys().hasOnly(['eid','by','at'])
        && request.resource.data.eid is string
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at is number
        && canPay(request.resource.data.eid);
      allow update: if signedIn()
        && canPay(resource.data.eid)
        && request.resource.data.eid == resource.data.eid;
      allow delete: if signedIn() && canPay(resource.data.eid);
    }

    // App version control: everyone can read, nobody can write from the app. Edit this doc in the Firebase console.
    match /appconfig/{id} {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
